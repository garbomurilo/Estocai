rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.email.matches('.*@(brasinha|estocai)\\.com.*');
    }

    // Coleção de Produtos:
    // Qualquer usuário autenticado (ou cliente visualizando cardápio público) pode ler.
    // Alterações diretas no estoque ou preço são bloqueadas para clientes comuns;
    // apenas o Admin ou as Cloud Functions (via Admin SDK com bypass de rules) podem executar a baixa.
    match /produtos/{produtoId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }

    // Coleção de Clientes (Programa de Fidelidade):
    match /clientes/{clienteId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Coleção de Pedidos e Vendas:
    // Leitura permitida para operadores autenticados.
    // Criação permitida com validação de campos obrigatórios.
    match /pedidos/{pedidoId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() 
        && request.resource.data.keys().hasAll(['itens', 'valor_total', 'status', 'data_hora'])
        && request.resource.data.valor_total >= 0;
      allow update, delete: if isAdmin();
    }

    // Regra padrão: nega acesso não explicitamente concedido
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
